# Public site origin for canonical and Open Graph URLs. No trailing slash.
SITE_URL=

# Optional subpath, such as /lawn. No trailing slash.
PATH_PREFIX=

# Season override for one build: holiday or standard.
# Leave empty to use the season value in src/_data/site.js.
SEASON=

# Reserved for a future email integration. Leave blank. Mail is not sent.
ESTIMATE_TO=

# SFTP deploy. Set a password or a private key path, not both required.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY=
SFTP_REMOTE_ROOT=
