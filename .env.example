# Public site origin. Hostname or absolute URL, no trailing slash.
# A hostname without a protocol is published as https. Put any subpath in PATH_PREFIX.
SITE_URL=

# Optional subpath, such as /lawn. No trailing slash.
PATH_PREFIX=

# Season override for one build: holiday or standard.
# Leave empty to use the season value in src/_data/site.js.
SEASON=

# Mailbox that receives estimate requests. The build writes this into api/estimate.php.
ESTIMATE_TO=

# SFTP deploy. Set a password or a private key path, not both required.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY=
SFTP_REMOTE_ROOT=
