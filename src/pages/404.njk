---
layout: layouts/base.njk
permalink: /404.html
eleventyExcludeFromCollections: true
---
<main id="main" class="page-main" tabindex="-1" style="min-height:100%;display:flex;align-items:center;justify-content:center;background:#F8F7F2;padding:72px 24px;box-sizing:border-box">
  <div style="max-width:520px;width:100%;text-align:center;display:flex;flex-direction:column;align-items:center;gap:18px">
    <a href="{{ '/' | url }}" style="display:inline-flex;align-items:center;gap:12px;text-decoration:none;color:#103D27">
      <img src="{{ '/assets/img/green-garden-lawn-care-logo.jpg' | url }}" alt="" width="52" height="52" style="height:52px;width:52px;object-fit:cover;border-radius:50%;background:#fff">
      <span style="font-family:'DM Serif Display',serif;font-size:22px;line-height:1.1;text-align:left">{{ site.wordmarkPrimary }}<br><span style="font-family:Manrope,sans-serif;font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#C6A35A">{{ site.wordmarkSecondary }}</span></span>
    </a>
    <h1 style="margin:8px 0 0;font-family:'DM Serif Display',serif;font-weight:400;font-size:clamp(36px,5vw,52px);line-height:1.05;color:#103D27">Page not found</h1>
    <p style="margin:0;color:#4A554E;font-size:17px;line-height:1.6">That page is not on the {{ site.name }} site.</p>
    <p style="margin:0;display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
      <a href="{{ '/' | url }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;background:#103D27;color:#fff;text-decoration:none;font-weight:700;border-radius:4px">Back to the homepage</a>
      <a href="{{ site.phoneHref }}" style="display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border:1px solid #103D27;color:#103D27;text-decoration:none;font-weight:700;border-radius:4px">Call {{ site.phone }}</a>
    </p>
  </div>
</main>
