---
permalink: /.htaccess
eleventyExcludeFromCollections: true
layout: false
---
ErrorDocument 404 {{ "/404.html" | url }}

<Files ".htaccess">
  Require all denied
</Files>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2|webp|jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
