<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="icon" href="{{ '/assets/favicon-32.png' | url }}" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="{{ '/assets/apple-touch-icon.png' | url }}" sizes="180x180">
<meta name="description" content="{{ description }}">
{% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
<link rel="canonical" href="{{ page.url | share }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ page.url | share }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_US">
{% set shareImage = heroImage %}
{% set shareAlt = heroAlt %}
{% if not shareImage %}
{% set shareImage = "/assets/img/green-garden-lawn-care-logo.jpg" %}
{% set shareAlt = site.name %}
{% endif %}
{% set shareMeta = shareImage | imageMeta %}
{% if shareMeta.width >= 200 %}
<meta property="og:image" content="{{ shareImage | share }}">
<meta property="og:image:type" content="{{ shareMeta.type }}">
<meta property="og:image:width" content="{{ shareMeta.width }}">
<meta property="og:image:height" content="{{ shareMeta.height }}">
{% if shareAlt %}<meta property="og:image:alt" content="{{ shareAlt }}">{% endif %}
{% endif %}
{% if heroImage %}
{% set heroVisual = heroImage | mobilePreload %}
{% if heroVisual %}
<link rel="preload" as="image" href="{{ heroVisual.href }}" imagesrcset="{{ heroVisual.srcset }}" imagesizes="100vw" fetchpriority="high" type="image/webp">
{% else %}
<link rel="preload" as="image" href="{{ heroImage | url }}" fetchpriority="high">
{% endif %}
{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
{% if shareMeta.width >= 200 %}
<meta name="twitter:image" content="{{ shareImage | share }}">
{% if shareAlt %}<meta name="twitter:image:alt" content="{{ shareAlt }}">{% endif %}
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
{% if schema == "LocalBusiness" %}
<script type="application/ld+json">{{ site | jsonLd(page.url | share, heroImage | share, title, description, "/assets/img/green-garden-lawn-care-logo.jpg" | share) | safe }}</script>
{% endif %}
</head>
<body data-season="{{ site.season }}">
{% if site.gtmId %}
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtmId }}" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
{% endif %}
<div id="dc-root">
<div class="sc-host" data-sc-name="home">
<a class="skip-link" href="#main">Skip to content</a>
{{ content | safe }}
</div>
</div>
{% if needsJs %}
<script type="module" src="{{ '/assets/js/home.js' | url }}"></script>
{% endif %}
{% if site.gtmId %}
<script>
window.dataLayer = window.dataLayer || [];
(function () {
  var id = "{{ site.gtmId }}";
  function loadGtm() {
    if (window.__gtmLoaded) return;
    window.__gtmLoaded = true;
    var w = window, d = document, s = "script", l = "dataLayer";
    w[l] = w[l] || [];
    w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
    var j = d.createElement(s), dl = l === "dataLayer" ? "" : "&l=" + l;
    j.async = true;
    j.src = "https://www.googletagmanager.com/gtm.js?id=" + id + dl;
    d.head.appendChild(j);
  }
  if (document.readyState === "complete") loadGtm();
  else window.addEventListener("load", loadGtm, { once: true });
})();
</script>
{% endif %}
</body>
</html>
